# ─── Status & Debug ────────────────────────────────────────────

# 重启/改 shape 之后跑这个 —— 全部不变量一次核完（只读，失败即非零退出）。
# 条数是循环里动态累加的，别写死：脚本结尾自己报「N 项通过 / M 项失败」。
# 由来: 2026-08-05 手工改 VM 为 2c/12G 后逐项验收花了二十来条命令，且漏项是静默的
# （当天漏了 hugepages + kubelet-arg，唯一症状是 capacity−allocatable 恰好 2048Mi）。
verify-node:
    bash ../../scripts/verify-oracle-node.sh

# 漂移检测：live 节点 vs ansible 里固化的状态。**只读**（--check 从不改机器）。
# `changed=0` = 无漂移。任何一条 changed 都是真漂移 —— 2026-08-05 把两个结构性
# 假阳性清掉了（firewalld reload 改成 handler；两条永远无法收敛的 FORWARD 规则删除，
# 因为 Cilium 会重建 FORWARD 链把它们丢掉），所以这个信号现在可信。
# 与 verify-node 互补：这个查「配置有没有漂移」，那个查「结果对不对」。
check-node-drift:
    cd ansible && ansible-playbook --check --diff playbooks/setup-k3s.yaml

# ─── PSA（Pod Security Admission）─────────────────────────────────
# 本集群的 PSA 标签**绝大多数写在清单里**（manifests/*/namespace.yaml，CI 的 H5 强制），
# 这里只管**清单管不到的那几个** —— Helm chart / k3s 自建的 ns，仓库里根本没有对应对象。
# 刻意不为它们补 Namespace 清单：那等于把 ns 交给 ArgoCD prune，正是 2026-08-03
# 级联删除事故的成因（见 manifests/zitadel/namespace.yaml 文件头）。
#
# ⚠️ trivy-system 必须 privileged，别照 dry-run 的干净结果给 baseline：
# operator ConfigMap 的 nodeCollector.volumes 挂 /var/lib/etcd 等 hostPath，
# node-collector 是**周期 Job**，dry-run 那一刻不在场——给 baseline 会让它静默扫不了。
psa_baseline_ns := "default external-secrets cnpg-system"
psa_privileged_ns := "kube-system trivy-system"

# 给清单外的 ns 打 PSA 标签（幂等）
harden-psa:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "▶ enforce=baseline (+ warn/audit=baseline)"
    for ns in {{psa_baseline_ns}}; do
        kubectl --context {{ctx}} get ns "$ns" >/dev/null 2>&1 || { echo "  ⏭ $ns 不存在，跳过"; continue; }
        kubectl --context {{ctx}} label namespace "$ns" \
            pod-security.kubernetes.io/enforce=baseline \
            pod-security.kubernetes.io/enforce-version=latest \
            pod-security.kubernetes.io/warn=baseline \
            pod-security.kubernetes.io/warn-version=latest \
            pod-security.kubernetes.io/audit=baseline \
            pod-security.kubernetes.io/audit-version=latest \
            --overwrite
    done
    echo "▶ enforce=privileged (显式豁免, warn/audit 仍记 baseline)"
    for ns in {{psa_privileged_ns}}; do
        kubectl --context {{ctx}} get ns "$ns" >/dev/null 2>&1 || { echo "  ⏭ $ns 不存在，跳过"; continue; }
        kubectl --context {{ctx}} label namespace "$ns" \
            pod-security.kubernetes.io/enforce=privileged \
            pod-security.kubernetes.io/warn=baseline \
            pod-security.kubernetes.io/warn-version=latest \
            pod-security.kubernetes.io/audit=baseline \
            pod-security.kubernetes.io/audit-version=latest \
            --overwrite
    done
    echo ""
    echo "✅ 清单外 ns 的 PSA 标签已应用。清单内的由 ArgoCD 同步（改 manifests/*/namespace.yaml）"

# PSA 漂移检查：跑着 Pod 却没有 enforce 标签的 ns → 非零退出（判据与 homelab 侧同）
psa-check:
    #!/usr/bin/env bash
    set -uo pipefail
    bad=0
    for ns in $(kubectl --context {{ctx}} get ns -L pod-security.kubernetes.io/enforce --no-headers | awk 'NF<4 {print $1}'); do
        n=$(kubectl --context {{ctx}} get pods -n "$ns" --no-headers 2>/dev/null | grep -c . || true)
        if [ "${n:-0}" -gt 0 ]; then
            echo "  ❌ $ns —— 无 enforce 标签却跑着 $n 个 Pod（静默吃默认 privileged，且无 warn/audit）"
            bad=$((bad+1))
        else
            echo "  ·  $ns —— 无标签，但也没有 Pod，忽略"
        fi
    done
    if [ "$bad" -gt 0 ]; then
        echo ""
        echo "❌ $bad 个 namespace 存在 PSA 漂移。修法二选一："
        echo "   · ns 由清单创建 → 改 manifests/<app>/namespace.yaml（CI 的 H5 会盯着）"
        echo "   · ns 由 Helm/k3s 创建 → 加进本 justfile 的 psa_* 列表再跑 just harden-psa"
        exit 1
    fi
    echo "✅ 所有跑着 Pod 的 namespace 都有 PSA enforce 标签"

# PSA 标签现状
psa-status:
    @kubectl --context {{ctx}} get ns -L pod-security.kubernetes.io/enforce,pod-security.kubernetes.io/warn,pod-security.kubernetes.io/audit

# Show cluster status
status:
    @echo "=== Pods ==="
    kubectl --context {{ctx}} get pods -A
    @echo ""
    @echo "=== Services ==="
    kubectl --context {{ctx}} get svc -A
    @echo ""
    @echo "=== ExternalSecrets ==="
    kubectl --context {{ctx}} get externalsecret -A
    @echo ""
    @echo "=== ClusterSecretStore ==="
    kubectl --context {{ctx}} get clustersecretstore
    @echo ""
    @echo "=== HTTPRoutes ==="
    kubectl --context {{ctx}} get httproute -A
    @echo ""
    @echo "=== Gateway ==="
    kubectl --context {{ctx}} get gateway -A

# Show rss-system status
status-rss:
    @echo "=== Pods ==="
    kubectl --context {{ctx}} get pods -n rss-system -o wide
    @echo ""
    @echo "=== ExternalSecrets ==="
    kubectl --context {{ctx}} get externalsecret -n rss-system
    @echo ""
    @echo "=== Services ==="
    kubectl --context {{ctx}} get svc -n rss-system

# Show monitoring status
status-monitoring:
    @echo "=== Monitoring Pods ==="
    kubectl --context {{ctx}} get pods -n monitoring -o wide
    @echo ""
    @echo "=== OTel Collector Logs ==="
    kubectl --context {{ctx}} logs -n monitoring -l app=otel-collector --tail=20

# Show logs for a pod
logs app ns="rss-system":
    kubectl --context {{ctx}} logs -n {{ns}} deployment/{{app}} --tail=50

# ─── Teardown ──────────────────────────────────────────────────

# Delete all kustomize-managed resources
teardown-apps:
    kubectl --context {{ctx}} delete -k manifests/ --ignore-not-found

# Destroy Cloudflare tunnel DNS records
teardown-cloudflare-dns:
    cd cloudflare && just destroy

# Full teardown
teardown: teardown-apps teardown-cloudflare-dns
    @echo "✅ All oracle-k3s resources removed"
