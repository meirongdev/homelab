# Oracle K3s Cluster Management
# All commands target the oracle-k3s kubectl context

set dotenv-load

ctx := "oracle-k3s"
vault_token := env_var_or_default("VAULT_TOKEN", "")

# ── 版本钉扎 ────────────────────────────────────────────────────────────────
# cilium_version / gateway_api_version 来自仓库根的 versions.just（两集群共享的同一个事实，
# 2026-09-02 起收敛）。☠️ 两集群 Cilium 版本劈叉会断 ClusterMesh —— 2026-08-10 就因为
# 本文件当时没有 --version、一次例行部署静默升版而真断过。背景全在那个文件里。
import '../../versions.just'

# 与 k8s/helm/justfile 的 eso_version 一致（两集群同版本，实测 helm list 均为 2.6.0）。
# renovate: datasource=helm depName=external-secrets registryUrl=https://charts.external-secrets.io
eso_version    := "2.6.0"

# ─── Node Setup ────────────────────────────────────────────────

# Provision K3s on the Oracle Cloud node
setup-node:
    cd ansible && just setup-k3s

# Fetch kubeconfig and merge into local ~/.kube/config
fetch-kubeconfig:
    cd ansible && just fetch-kubeconfig

# Install Tailscale on the node (requires authkey)
setup-tailscale authkey:
    cd ansible && just setup-tailscale {{authkey}}

# ─── Cilium CNI ─────────────────────────────────────────────────

# 安装/升级 Gateway API CRD —— Cilium 的前置条件。幂等；跑完重启 operator 并验收。
# ⚠️ --server-side 必需（httproutes CRD 429KB，客户端 apply 撑爆注解上限）；
#    TLSRoute 只在 experimental 频道。详见 k8s/helm/justfile 同名配方的注释。
deploy-gateway-api-crds:
    #!/usr/bin/env bash
    set -euo pipefail
    base="https://raw.githubusercontent.com/kubernetes-sigs/gateway-api/v{{gateway_api_version}}/config/crd"
    for c in gatewayclasses gateways httproutes grpcroutes referencegrants backendtlspolicies; do
        echo "→ standard/$c"
        kubectl --context {{ctx}} apply --server-side --force-conflicts \
            -f "$base/standard/gateway.networking.k8s.io_$c.yaml"
    done
    echo "→ experimental/tlsroutes"
    kubectl --context {{ctx}} apply --server-side --force-conflicts \
        -f "$base/experimental/gateway.networking.k8s.io_tlsroutes.yaml"
    kubectl --context {{ctx}} -n kube-system rollout restart deploy/cilium-operator
    kubectl --context {{ctx}} -n kube-system rollout status deploy/cilium-operator --timeout=3m
    if kubectl --context {{ctx}} -n kube-system logs deploy/cilium-operator --tail=300 \
        | grep -q "Required GatewayAPI resources are not found"; then
        echo "❌ Gateway API 控制器仍未初始化 —— 核对 CRD 版本与 Cilium 要求" && exit 1
    fi
    echo "✅ Gateway API CRD = v{{gateway_api_version}}，控制器已初始化"

# Deploy Cilium (replaces Flannel as CNI)
# ⚠️ 升级 Cilium 前先跑 `just deploy-gateway-api-crds`（或至少核对 gateway_api_version）。
deploy-cilium:
    # Reset release values so old manual --set flags cannot poison future upgrades, then
    # drop stale Hubble cert secrets so certgen re-issues them for the current cluster name.
    kubectl --context {{ctx}} -n kube-system delete secret hubble-server-certs hubble-relay-client-certs --ignore-not-found
    helm repo add cilium https://helm.cilium.io/ || true
    helm repo update cilium
    helm upgrade --install cilium cilium/cilium \
        --namespace kube-system \
        --kube-context {{ctx}} \
        --version {{cilium_version}} \
        --values values/cilium-values.yaml \
        --reset-values \
        --wait \
        --timeout 10m
    bash -euc 'for _ in $(seq 1 24); do \
        if kubectl --context {{ctx}} -n kube-system get job -l k8s-app=hubble-generate-certs -o name | grep -q .; then \
            kubectl --context {{ctx}} -n kube-system wait --for=condition=complete job -l k8s-app=hubble-generate-certs --timeout=5m; \
            exit 0; \
        fi; \
        sleep 5; \
    done; \
    echo "Timed out waiting for hubble-generate-certs job creation" >&2; \
    exit 1'
    kubectl --context {{ctx}} -n kube-system get secret hubble-server-certs hubble-relay-client-certs
    kubectl --context {{ctx}} -n kube-system rollout status deployment/hubble-relay --timeout=5m
    kubectl --context {{ctx}} exec -n kube-system ds/cilium -c cilium-agent -- cilium status --brief
    @echo ""
    @echo "⚠️  --reset-values 会冲掉跨集群 CA 信任 → ClusterMesh 会静默断开（2026-08-10 实测）。"
    @echo "   现在必须跑：just connect-clustermesh 100.94.186.7:32379 100.107.166.37:32379"
    @echo "   （在 k8s/helm/ 目录下）。判据看 'cilium status' 的 remote configuration: retrieved=true"

# Cilium 状态检查
cilium-status:
    kubectl --context {{ctx}} exec -n kube-system ds/cilium -c cilium-agent -- cilium status --brief

# Show bidirectional ClusterMesh / KVStoreMesh status
clustermesh-status:
    cilium clustermesh status --context k3s-homelab --wait
    cilium clustermesh status --context oracle-k3s --wait

# Reconnect ClusterMesh over Tailscale NodePort after rebuilding either cluster
connect-clustermesh homelab_endpoint oracle_endpoint:
    cilium clustermesh connect \
        --context k3s-homelab \
        --destination-context oracle-k3s \
        --source-endpoint {{homelab_endpoint}} \
        --destination-endpoint {{oracle_endpoint}} \
        --allow-mismatching-ca
    just clustermesh-status

# Hubble UI 端口转发
hubble-ui:
    @echo "Hubble UI is available at http://localhost:12000"
    kubectl --context {{ctx}} port-forward -n kube-system svc/hubble-ui 12000:80

# ─── Cluster Bootstrap ─────────────────────────────────────────

# Full cluster bootstrap (run after fresh K3s install)
bootstrap: deploy-cilium install-eso create-vault-token deploy-manifests deploy-cloudflare-tunnel
    @echo "✅ Oracle K3s cluster fully bootstrapped"

# Install External Secrets Operator via Helm
# ⚠️ 2026-08-10 补 --version 与 --values：此前两者都没有，`helm repo update` + 无 pin
#    等于每跑一次就升到 chart 最新版（cilium 那条 recipe 同样的坑，当天已实际踩中）。
install-eso:
    helm repo add external-secrets https://charts.external-secrets.io || true
    helm repo update
    helm upgrade --install external-secrets external-secrets/external-secrets \
        --namespace external-secrets \
        --create-namespace \
        --kube-context {{ctx}} \
        --version {{eso_version}} \
        --values values/external-secrets-values.yaml \
        --wait --timeout 5m

# Create Vault token secret (needed by ClusterSecretStore)
create-vault-token:
    kubectl --context {{ctx}} create namespace rss-system --dry-run=client -o yaml | kubectl --context {{ctx}} apply -f -
    kubectl --context {{ctx}} create secret generic vault-token \
        -n rss-system \
        --from-literal=token={{vault_token}} \
        --dry-run=client -o yaml | kubectl --context {{ctx}} apply -f -

# ─── Bootstrap-only apply ──────────────────────────────────────
# 日常部署不在这里：manifests/ 由 ArgoCD `oracle-k3s` App 同步，改文件 → git push 即生效，
# 手动 apply 会被 selfHeal 在 3 分钟内拉回（AGENTS.md 明令禁止）。2026-09-02 删掉了 7 条
# 绕过 GitOps 的 per-app apply / teardown 配方，只留下面这条给全新重建（ArgoCD 尚不存在时）用。

# 整树 apply 一次，把入口链路拉起来（bootstrap / ArgoCD 不可用时的应急）。见 runbooks/oracle-k3s-rebuild.md §5
deploy-manifests:
    kubectl --context {{ctx}} apply -k manifests/

# Run uptime-kuma provisioner job (creates admin + monitors)
provision-uptime-kuma:
    kubectl --context {{ctx}} delete job uptime-kuma-provisioner -n personal-services --ignore-not-found
    kubectl --context {{ctx}} apply -f manifests/uptime-kuma/provisioner.yaml
    @echo "⏳ Waiting for provisioner job to complete..."
    kubectl --context {{ctx}} wait --for=condition=complete job/uptime-kuma-provisioner -n personal-services --timeout=120s
    kubectl --context {{ctx}} logs job/uptime-kuma-provisioner -n personal-services

# Restart rss-system deployments
restart-rss:
    kubectl --context {{ctx}} rollout restart deployment -n rss-system

# Restart homepage (e.g. after ConfigMap update)
restart-homepage:
    kubectl --context {{ctx}} rollout restart deployment homepage -n homepage

# ─── Cloudflare Tunnel ─────────────────────────────────────────

# Deploy Cloudflare tunnel (DNS + K8s connector)
deploy-cloudflare-tunnel: deploy-cloudflare-dns deploy-cloudflare-connector

# Apply Cloudflare Terraform (DNS records + tunnel config)
deploy-cloudflare-dns:
    cd cloudflare && just apply

# Deploy cloudflared connector in the cluster
deploy-cloudflare-connector:
    kubectl --context {{ctx}} apply -f manifests/base/cloudflare-tunnel.yaml

# ─── Status & Debug ────────────────────────────────────────────

# 重启/改 shape 之后跑这个 —— 全部不变量一次核完（只读，失败即非零退出）。
# 条数是循环里动态累加的，别写死：脚本结尾自己报「N 项通过 / M 项失败」。
# 由来: 2026-08-05 手工改 VM 为 2c/12G 后逐项验收花了二十来条命令，且漏项是静默的
# （当天漏了 hugepages + kubelet-arg，唯一症状是 capacity−allocatable 恰好 2048Mi）。
verify-node:
    bash ../../scripts/verify-oracle-node.sh

# 漂移检测：live 节点 vs ansible 里固化的状态。**只读**（--check 从不改机器）。
# `changed=0` = 无漂移。任何一条 changed 都是真漂移 —— 2026-08-05 把两个结构性
# 假阳性清掉了（firewalld reload 改成 handler；两条永远无法收敛的 FORWARD 规则删除，
# 因为 Cilium 会重建 FORWARD 链把它们丢掉），所以这个信号现在可信。
# 与 verify-node 互补：这个查「配置有没有漂移」，那个查「结果对不对」。
check-node-drift:
    cd ansible && ansible-playbook --check --diff playbooks/setup-k3s.yaml

# ─── PSA（Pod Security Admission）─────────────────────────────────
# 本集群的 PSA 标签**绝大多数写在清单里**（manifests/*/namespace.yaml，CI 的 H5 强制），
# 这里只管**清单管不到的那几个** —— Helm chart / k3s 自建的 ns，仓库里根本没有对应对象。
# 刻意不为它们补 Namespace 清单：那等于把 ns 交给 ArgoCD prune，正是 2026-08-03
# 级联删除事故的成因（见 manifests/zitadel/namespace.yaml 文件头）。
#
# ⚠️ trivy-system 必须 privileged，别照 dry-run 的干净结果给 baseline：
# operator ConfigMap 的 nodeCollector.volumes 挂 /var/lib/etcd 等 hostPath，
# node-collector 是**周期 Job**，dry-run 那一刻不在场——给 baseline 会让它静默扫不了。
psa_baseline_ns := "default external-secrets cnpg-system"
psa_privileged_ns := "kube-system trivy-system"

# 给清单外的 ns 打 PSA 标签（幂等）
harden-psa:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "▶ enforce=baseline (+ warn/audit=baseline)"
    for ns in {{psa_baseline_ns}}; do
        kubectl --context {{ctx}} get ns "$ns" >/dev/null 2>&1 || { echo "  ⏭ $ns 不存在，跳过"; continue; }
        kubectl --context {{ctx}} label namespace "$ns" \
            pod-security.kubernetes.io/enforce=baseline \
            pod-security.kubernetes.io/enforce-version=latest \
            pod-security.kubernetes.io/warn=baseline \
            pod-security.kubernetes.io/warn-version=latest \
            pod-security.kubernetes.io/audit=baseline \
            pod-security.kubernetes.io/audit-version=latest \
            --overwrite
    done
    echo "▶ enforce=privileged (显式豁免, warn/audit 仍记 baseline)"
    for ns in {{psa_privileged_ns}}; do
        kubectl --context {{ctx}} get ns "$ns" >/dev/null 2>&1 || { echo "  ⏭ $ns 不存在，跳过"; continue; }
        kubectl --context {{ctx}} label namespace "$ns" \
            pod-security.kubernetes.io/enforce=privileged \
            pod-security.kubernetes.io/warn=baseline \
            pod-security.kubernetes.io/warn-version=latest \
            pod-security.kubernetes.io/audit=baseline \
            pod-security.kubernetes.io/audit-version=latest \
            --overwrite
    done
    echo ""
    echo "✅ 清单外 ns 的 PSA 标签已应用。清单内的由 ArgoCD 同步（改 manifests/*/namespace.yaml）"

# PSA 漂移检查：跑着 Pod 却没有 enforce 标签的 ns → 非零退出（判据与 homelab 侧同）
psa-check:
    #!/usr/bin/env bash
    set -uo pipefail
    bad=0
    for ns in $(kubectl --context {{ctx}} get ns -L pod-security.kubernetes.io/enforce --no-headers | awk 'NF<4 {print $1}'); do
        n=$(kubectl --context {{ctx}} get pods -n "$ns" --no-headers 2>/dev/null | grep -c . || true)
        if [ "${n:-0}" -gt 0 ]; then
            echo "  ❌ $ns —— 无 enforce 标签却跑着 $n 个 Pod（静默吃默认 privileged，且无 warn/audit）"
            bad=$((bad+1))
        else
            echo "  ·  $ns —— 无标签，但也没有 Pod，忽略"
        fi
    done
    if [ "$bad" -gt 0 ]; then
        echo ""
        echo "❌ $bad 个 namespace 存在 PSA 漂移。修法二选一："
        echo "   · ns 由清单创建 → 改 manifests/<app>/namespace.yaml（CI 的 H5 会盯着）"
        echo "   · ns 由 Helm/k3s 创建 → 加进本 justfile 的 psa_* 列表再跑 just harden-psa"
        exit 1
    fi
    echo "✅ 所有跑着 Pod 的 namespace 都有 PSA enforce 标签"

# PSA 标签现状
psa-status:
    @kubectl --context {{ctx}} get ns -L pod-security.kubernetes.io/enforce,pod-security.kubernetes.io/warn,pod-security.kubernetes.io/audit

# Show cluster status
status:
    @echo "=== Pods ==="
    kubectl --context {{ctx}} get pods -A
    @echo ""
    @echo "=== Services ==="
    kubectl --context {{ctx}} get svc -A
    @echo ""
    @echo "=== ExternalSecrets ==="
    kubectl --context {{ctx}} get externalsecret -A
    @echo ""
    @echo "=== ClusterSecretStore ==="
    kubectl --context {{ctx}} get clustersecretstore
    @echo ""
    @echo "=== HTTPRoutes ==="
    kubectl --context {{ctx}} get httproute -A
    @echo ""
    @echo "=== Gateway ==="
    kubectl --context {{ctx}} get gateway -A

# Show rss-system status
status-rss:
    @echo "=== Pods ==="
    kubectl --context {{ctx}} get pods -n rss-system -o wide
    @echo ""
    @echo "=== ExternalSecrets ==="
    kubectl --context {{ctx}} get externalsecret -n rss-system
    @echo ""
    @echo "=== Services ==="
    kubectl --context {{ctx}} get svc -n rss-system

# Show monitoring status
status-monitoring:
    @echo "=== Monitoring Pods ==="
    kubectl --context {{ctx}} get pods -n monitoring -o wide
    @echo ""
    @echo "=== OTel Collector Logs ==="
    kubectl --context {{ctx}} logs -n monitoring -l app=otel-collector --tail=20

# Show logs for a pod
logs app ns="rss-system":
    kubectl --context {{ctx}} logs -n {{ns}} deployment/{{app}} --tail=50

# ─── Teardown ──────────────────────────────────────────────────
# 2026-09-02 删掉了 `teardown-apps`（kubectl delete -k 整树：selfHeal 会立刻重建，且一条命令无确认）
# 与把它和 DNS 销毁串在一起的 `teardown`。退役单个服务照 docs/runbooks/stateful-service-cross-cluster-migration.md
# 的「退役与残余清扫」走；整集群销毁走 terraform（cloud/oracle/terraform，`make destroy`）。

# Destroy Cloudflare tunnel DNS records
teardown-cloudflare-dns:
    cd cloudflare && just destroy
