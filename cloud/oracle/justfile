    kubectl --context {{ctx}} apply -f manifests/homepage/

# Deploy personal services (IT-Tools, Stirling-PDF, Squoosh)
deploy-personal-services:
    kubectl --context {{ctx}} apply -f manifests/personal-services/

# Deploy Timeslot via Helm chart (sparse-clones upstream chart, injects secret from Vault)
# Requires VAULT_TOKEN env var. Run after storing secret:
#   kubectl --context k3s-homelab exec -n vault vault-0 -- \
#     sh -c "VAULT_TOKEN=$VAULT_TOKEN vault kv put secret/oracle-k3s/timeslot admin_password=<pw>"
deploy-timeslot:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "📦 Fetching admin_password from Vault (secret/oracle-k3s/timeslot)..."
    ADMIN_PASSWORD=$(kubectl --context k3s-homelab exec -n vault vault-0 -- \
      sh -c "VAULT_TOKEN=${VAULT_TOKEN} vault kv get -field=admin_password secret/oracle-k3s/timeslot")
    echo "🔀 Sparse-cloning timeslot Helm chart from GitHub..."
    TMPDIR=$(mktemp -d)
    trap "rm -rf $TMPDIR" EXIT
    git clone --depth 1 --filter=blob:none --sparse \
      https://github.com/meirongdev/timeslot.git "$TMPDIR"
    git -C "$TMPDIR" sparse-checkout set deploy/helm
    echo "🚀 Installing/upgrading timeslot Helm release..."
    # Note: --wait omitted intentionally; chart bugs are patched below before waiting
    # image 用 digest 固定（原 :latest，供应链卫生/可复现）。部署新构建时：在 timeslot 仓库打
    # 版本 tag 后用该 tag，或把下面 digest 换成新构建的 digest。
    helm upgrade --install timeslot "$TMPDIR/deploy/helm" \
      --kube-context {{ctx}} \
      --namespace personal-services \
      --create-namespace \
      --set image=ghcr.io/meirongdev/timeslot/timeslot@sha256:27c17dace6f713015f2f9df451a647e9c971daee7a22a444db6e0512e57f5230 \
      --set persistence.size=100Mi \
      --set persistence.storageClass=local-path \
      --set config.adminPassword="$ADMIN_PASSWORD"
    # Workaround upstream chart bugs (pending fix in meirongdev/timeslot):
    # Bug 1: liveness probe path /admin/ requires auth → 401 → CrashLoopBackOff
    # Bug 2: init container sed uses $(ADMIN_PASSWORD) as shell command substitution (expands
    #        to empty), so the placeholder is never replaced. Fixed with awk which treats the
    #        literal $(...) as a regex pattern rather than a shell expression.
    echo "🔧 Patching chart bugs (liveness probe + init container)..."
    printf '[{"op":"replace","path":"/spec/template/spec/containers/0/livenessProbe/httpGet/path","value":"/api/slots"},{"op":"replace","path":"/spec/template/spec/initContainers/0/command","value":["sh","-c","awk -v pw=\\"$ADMIN_PASSWORD\\" '"'"'{gsub(/\\$\\(ADMIN_PASSWORD\\)/, pw)}1'"'"' /config-template/config.json > /config/config.json"]}]' > /tmp/timeslot-chart-fix.json
    kubectl --context {{ctx}} patch deployment timeslot -n personal-services \
      --type=json --patch-file=/tmp/timeslot-chart-fix.json
    kubectl --context {{ctx}} rollout status deployment timeslot \
      -n personal-services --timeout=3m
    echo "✅ Timeslot deployed. Apply HTTPRoute with: just deploy-personal-services"

