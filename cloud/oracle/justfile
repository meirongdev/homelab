# Oracle K3s Cluster Management
# All commands target the oracle-k3s kubectl context

set dotenv-load

ctx := "oracle-k3s"
vault_token := env_var_or_default("VAULT_TOKEN", "")

# ⚠️ 2026-08-10 补 pin —— 本文件此前**没有** --version，而 deploy-cilium 前一步就是
# `helm repo update cilium`：一次只为改 resources 的例行部署把 oracle 从 1.19.1 静默
# 升到了 1.20.0，两集群劈叉导致 oracle→homelab ClusterMesh `retrieved=false`。
# 同一条规则仓库里本来就写着（argocd/applications/kube-prometheus-stack.yaml:25
# 「chart 版本必须 pin：不 pin 时会随 chart repo 更新意外整栈升级」），只是没覆盖到这里。
# ⚠️ 必须与 k8s/helm/justfile 的 cilium_version 保持一致 —— 两集群版本劈叉会断 ClusterMesh。
cilium_version := "1.20.0"
# Cilium 1.20 要求的 Gateway API CRD 版本。⚠️ 与 k8s/helm/justfile 的 gateway_api_version 一致。
# ☠️ 2026-08-11：这组 CRD 停留在 v1.2.1，导致两集群 Gateway API 控制器**静默瘫痪 30 小时**
#    （新路由全部拿不到 status，旧路由照常 200 所以没人发现）。原委见 k8s/helm/justfile
#    顶部 cilium_version 上方的长注释；修复配方 `just deploy-gateway-api-crds`。
gateway_api_version := "1.6.1"
# 与 k8s/helm/justfile 的 eso_version 一致（两集群同版本，实测 helm list 均为 2.6.0）。
eso_version    := "2.6.0"

# ─── Node Setup ────────────────────────────────────────────────

# Provision K3s on the Oracle Cloud node
setup-node:
    cd ansible && just setup-k3s

# Fetch kubeconfig and merge into local ~/.kube/config
fetch-kubeconfig:
    cd ansible && just fetch-kubeconfig

# Install Tailscale on the node (requires authkey)
setup-tailscale authkey:
    cd ansible && just setup-tailscale {{authkey}}

# ─── Cilium CNI ─────────────────────────────────────────────────

# 安装/升级 Gateway API CRD —— Cilium 的前置条件。幂等；跑完重启 operator 并验收。
# ⚠️ --server-side 必需（httproutes CRD 429KB，客户端 apply 撑爆注解上限）；
#    TLSRoute 只在 experimental 频道。详见 k8s/helm/justfile 同名配方的注释。
deploy-gateway-api-crds:
    #!/usr/bin/env bash
    set -euo pipefail
    base="https://raw.githubusercontent.com/kubernetes-sigs/gateway-api/v{{gateway_api_version}}/config/crd"
    for c in gatewayclasses gateways httproutes grpcroutes referencegrants backendtlspolicies; do
        echo "→ standard/$c"
        kubectl --context {{ctx}} apply --server-side --force-conflicts \
            -f "$base/standard/gateway.networking.k8s.io_$c.yaml"
    done
    echo "→ experimental/tlsroutes"
    kubectl --context {{ctx}} apply --server-side --force-conflicts \
        -f "$base/experimental/gateway.networking.k8s.io_tlsroutes.yaml"
    kubectl --context {{ctx}} -n kube-system rollout restart deploy/cilium-operator
    kubectl --context {{ctx}} -n kube-system rollout status deploy/cilium-operator --timeout=3m
    if kubectl --context {{ctx}} -n kube-system logs deploy/cilium-operator --tail=300 \
        | grep -q "Required GatewayAPI resources are not found"; then
        echo "❌ Gateway API 控制器仍未初始化 —— 核对 CRD 版本与 Cilium 要求" && exit 1
    fi
    echo "✅ Gateway API CRD = v{{gateway_api_version}}，控制器已初始化"

# Deploy Cilium (replaces Flannel as CNI)
# ⚠️ 升级 Cilium 前先跑 `just deploy-gateway-api-crds`（或至少核对 gateway_api_version）。
deploy-cilium:
    # Reset release values so old manual --set flags cannot poison future upgrades, then
    # drop stale Hubble cert secrets so certgen re-issues them for the current cluster name.
    kubectl --context {{ctx}} -n kube-system delete secret hubble-server-certs hubble-relay-client-certs --ignore-not-found
    helm repo add cilium https://helm.cilium.io/ || true
    helm repo update cilium
    helm upgrade --install cilium cilium/cilium \
        --namespace kube-system \
        --kube-context {{ctx}} \
        --version {{cilium_version}} \
        --values values/cilium-values.yaml \
        --reset-values \
        --wait \
        --timeout 10m
    bash -euc 'for _ in $(seq 1 24); do \
        if kubectl --context {{ctx}} -n kube-system get job -l k8s-app=hubble-generate-certs -o name | grep -q .; then \
            kubectl --context {{ctx}} -n kube-system wait --for=condition=complete job -l k8s-app=hubble-generate-certs --timeout=5m; \
            exit 0; \
        fi; \
        sleep 5; \
    done; \
    echo "Timed out waiting for hubble-generate-certs job creation" >&2; \
    exit 1'
    kubectl --context {{ctx}} -n kube-system get secret hubble-server-certs hubble-relay-client-certs
    kubectl --context {{ctx}} -n kube-system rollout status deployment/hubble-relay --timeout=5m
    kubectl --context {{ctx}} exec -n kube-system ds/cilium -c cilium-agent -- cilium status --brief
    @echo ""
    @echo "⚠️  --reset-values 会冲掉跨集群 CA 信任 → ClusterMesh 会静默断开（2026-08-10 实测）。"
    @echo "   现在必须跑：just connect-clustermesh 100.94.186.7:32379 100.107.166.37:32379"
    @echo "   （在 k8s/helm/ 目录下）。判据看 'cilium status' 的 remote configuration: retrieved=true"

# Cilium 状态检查
cilium-status:
    kubectl --context {{ctx}} exec -n kube-system ds/cilium -c cilium-agent -- cilium status --brief

# Show bidirectional ClusterMesh / KVStoreMesh status
clustermesh-status:
    cilium clustermesh status --context k3s-homelab --wait
    cilium clustermesh status --context oracle-k3s --wait

# Reconnect ClusterMesh over Tailscale NodePort after rebuilding either cluster
connect-clustermesh homelab_endpoint oracle_endpoint:
    cilium clustermesh connect \
        --context k3s-homelab \
        --destination-context oracle-k3s \
        --source-endpoint {{homelab_endpoint}} \
        --destination-endpoint {{oracle_endpoint}} \
        --allow-mismatching-ca
    just clustermesh-status

# Hubble UI 端口转发
hubble-ui:
    @echo "Hubble UI is available at http://localhost:12000"
    kubectl --context {{ctx}} port-forward -n kube-system svc/hubble-ui 12000:80

# ─── Cluster Bootstrap ─────────────────────────────────────────

# Full cluster bootstrap (run after fresh K3s install)
bootstrap: deploy-cilium install-eso create-vault-token deploy-manifests deploy-cloudflare-tunnel
    @echo "✅ Oracle K3s cluster fully bootstrapped"

# Install External Secrets Operator via Helm
# ⚠️ 2026-08-10 补 --version 与 --values：此前两者都没有，`helm repo update` + 无 pin
#    等于每跑一次就升到 chart 最新版（cilium 那条 recipe 同样的坑，当天已实际踩中）。
install-eso:
    helm repo add external-secrets https://charts.external-secrets.io || true
    helm repo update
    helm upgrade --install external-secrets external-secrets/external-secrets \
        --namespace external-secrets \
        --create-namespace \
        --kube-context {{ctx}} \
        --version {{eso_version}} \
        --values values/external-secrets-values.yaml \
        --wait --timeout 5m

# Create Vault token secret (needed by ClusterSecretStore)
create-vault-token:
    kubectl --context {{ctx}} create namespace rss-system --dry-run=client -o yaml | kubectl --context {{ctx}} apply -f -
    kubectl --context {{ctx}} create secret generic vault-token \
        -n rss-system \
        --from-literal=token={{vault_token}} \
        --dry-run=client -o yaml | kubectl --context {{ctx}} apply -f -

# ─── Application Deployment ────────────────────────────────────

# Deploy all K8s manifests (base infra + all apps)
deploy-manifests:
    kubectl --context {{ctx}} apply -k manifests/

# Deploy only rss-system app manifests
deploy-rss:
    kubectl --context {{ctx}} apply -f manifests/rss-system/

# Deploy only KaraKeep + Redpanda Connect
deploy-info-pipeline:
