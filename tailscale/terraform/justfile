set dotenv-load := true

# 所有 terraform 调用都经这个包装：它从 Vault 取 R2 后端凭据（state 在 R2，见
# docs/reference/terraform-state.md）。裸敲 terraform 会因缺凭据失败。
terraform := source_directory() / "../../scripts/tf-r2.sh"

init:
    {{terraform}} init

plan:
    {{terraform}} plan \
        -var="tailscale_oauth_client_id=$TAILSCALE_OAUTH_CLIENT_ID" \
        -var="tailscale_oauth_client_secret=$TAILSCALE_OAUTH_CLIENT_SECRET"

apply:
    {{terraform}} apply -auto-approve \
        -var="tailscale_oauth_client_id=$TAILSCALE_OAUTH_CLIENT_ID" \
        -var="tailscale_oauth_client_secret=$TAILSCALE_OAUTH_CLIENT_SECRET"

# 获取 homelab 节点的 pre-auth key（用于 Ansible setup-tailscale）
homelab-authkey:
    {{terraform}} output -raw homelab_authkey

# 获取 Oracle 节点的 pre-auth key（用于 Ansible setup-tailscale）
oracle-authkey:
    {{terraform}} output -raw oracle_authkey

# 获取 106 worker 的 pre-auth key（用于 k8s/ansible 的 just setup-tailscale-worker）
homelab-worker-authkey:
    {{terraform}} output -raw homelab_worker_authkey

# 任意 terraform 子命令，带上 R2 后端凭据：如 `tf state list`、`tf output`
[positional-arguments]
tf *args:
    @{{terraform}} "$@"
