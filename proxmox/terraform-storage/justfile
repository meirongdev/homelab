# storage-106 terraform tasks
# ⚠️ 本机直连两台 PVE 的 :8006 均不通（SSH 22 正常）——所以 plan/apply 依赖 _tunnel。

# Show help
help:
    @just --list --unsorted

# SSH 隧道 → 106 的 PVE API（幂等：已有隧道就复用；10 分钟自动退出）
_tunnel:
    @pgrep -f "ssh.*-L 18006:127.0.0.1:8006" >/dev/null || \
      ssh -f -o ExitOnForwardFailure=yes -o ConnectTimeout=8 -i ~/.ssh/vgio \
        -L 18006:127.0.0.1:8006 root@192.168.50.106 sleep 600
    # 等端口真的在监听再返回（`ssh -f` 返回 ≠ 转发就绪，否则 terraform 首个 API 调用会被拒）
    @for i in $(seq 1 20); do nc -z 127.0.0.1 18006 2>/dev/null && break; sleep 0.5; done

# Initialize Terraform and create tfvars if it doesn't exist
init:
    @if [ ! -f terraform.tfvars ]; then \
      echo "Creating terraform.tfvars from example (记得填 api token，见 provider.tf 注释)..."; \
      cp terraform.tfvars.example terraform.tfvars; \
    fi
    terraform init

# Plan all changes
plan: _tunnel
    terraform plan -out=terraform.plan

# Apply the plan
apply: _tunnel
    terraform apply terraform.plan

# ☠️ 这台 VM 自 2026-08-13 起是 **homelab 集群的 worker `k8s-worker-106`**，
#    不再是「随便拆」的实验田。destroy 会让 prod 集群 node NotReady。
#    要拆先在集群里 drain + delete node：
#      kubectl --context k3s-homelab drain k8s-worker-106 --ignore-daemonsets --delete-emptydir-data
#      kubectl --context k3s-homelab delete node k8s-worker-106
#    决策：docs/decisions/storage106-as-homelab-worker.md
destroy: _tunnel
    terraform destroy
