# 管两台远程 Mac：M2 MacBook（mbp-m2-pro）与 Mac Studio（mac-studio），外加本机 M5（m5，
# 本地连接，只进开发环境的 base/dev/ops 组），见 inventory.yaml。
# 带 `target` 参数的配方默认作用于该 playbook 的整个主机组，也可以传主机名或组名
# （ansible --limit 语法）只跑一台：`just node-exporter mac-studio`。
# 需要 sudo 的配方（power / site）逐台运行、逐台问密码 —— 两台的登录密码不同，
# `--ask-become-pass` 只问一次，一次跑两台必有一台认证失败。

# Show help
help:
    @just --list --unsorted

# 连通性检查（经 Tailscale ping 每台 Mac）
ping target="macs":
    ansible-playbook playbooks/ping.yaml --limit '{{target}}'

# base 组：Homebrew + 基础 CLI + oh-my-zsh/插件/TPM；ops 组另加 k8s/云/IaC 工具。
# 只补装不升级。.zshrc 等配置文件归 chezmoi，这里不碰。
# 开发环境的软件（base 层每台 + ops 层；无需 sudo，幂等）
packages target="base":
    ansible-playbook playbooks/packages.yaml --limit '{{target}}'

# 写 ~/.config/mise/config.toml 并装齐；shell 里要有 `mise activate` 才生效（归 chezmoi）。
# 语言运行时（mise：node/pnpm/bun/go/python/java/maven/gradle/rust，仅 dev 组，无需 sudo，幂等）
mise target="dev":
    ansible-playbook playbooks/mise.yaml --limit '{{target}}'

# claude/qwen/codex 只装 M2（macbook 组），Antigravity CLI（agy）装每台（base 组）。
# 安装/确认 AI CLI 工具（无需 sudo，幂等）
ai-clis target="all":
    ansible-playbook playbooks/ai-clis.yaml --limit '{{target}}'

# 每台的 LiteLLM 虚拟 key 从 Vault 现取（secret/homelab/magpie，字段名 = inventory 主机名），
# 整份 JSON 经环境变量 MAGPIE_LITELLM_KEYS 传给 playbook：不上命令行、不落盘、不进 git。
# 取不到时 playbook 第一步就失败，不会去碰 magpie。
# 安装/配置 Magpie 及 Homelab 网关路由（无需 sudo，幂等）
magpie target="macs":
    #!/usr/bin/env bash
    set -euo pipefail
    export VAULT_ADDR="${VAULT_ADDR:-https://vault.meirong.dev}"
    MAGPIE_LITELLM_KEYS="$(vault kv get -format=json secret/homelab/magpie 2>/dev/null | jq -c '.data.data // empty' || true)"
    [ -n "$MAGPIE_LITELLM_KEYS" ] || echo "⚠️  Vault 里取不到 secret/homelab/magpie（vault token 过期？）" >&2
    export MAGPIE_LITELLM_KEYS
    ansible-playbook playbooks/magpie.yaml --limit '{{target}}'


# 顺带给它加 --collector.textfile.directory —— 那是 OMLX 指标的**读取端**，
# 生产端是下面的 omlx-metrics。
# 部署/升级 node_exporter LaunchAgent（无需 sudo）
node-exporter target="macs":
    ansible-playbook playbooks/node-exporter.yaml --limit '{{target}}'

# key 从 Vault 现取（secret/homelab/omlx → api_key），经环境变量传给 playbook，
# 不上命令行、不落盘。取不到时：已配过 key 的机器照常，新机器会在启动服务前失败。
# OMLX 推理服务本体（brew + LaunchAgent + settings.json 的 host/port/鉴权；不升级、不碰模型）
omlx target="omlx":
    #!/usr/bin/env bash
    set -euo pipefail
    export VAULT_ADDR="${VAULT_ADDR:-https://vault.meirong.dev}"
    OMLX_API_KEY="$(vault kv get -field=api_key secret/homelab/omlx 2>/dev/null || true)"
    [ -n "$OMLX_API_KEY" ] || echo "⚠️  Vault 里取不到 secret/homelab/omlx → api_key（vault token 过期？）" >&2
    export OMLX_API_KEY
    ansible-playbook playbooks/omlx.yaml --limit '{{target}}'

# OMLX 指标的**生产端**，读取端在 `just node-exporter`（那边加 textfile flag）。
# 两个都跑过才有指标；只跑一个不报错，指标静默不出现。
# ⚠️ 渲染器是 mlx-learning 仓 venv 里的 console script（跨仓依赖），缺了会明确失败。
# 部署/升级 OMLX 指标采集 LaunchAgent（stats.json → node_exporter textfile 快照）
omlx-metrics target="omlx":
    ansible-playbook playbooks/omlx-metrics.yaml --limit '{{target}}'

# macOS 27 上 CPU/内存/ANE 功耗读 0、M2 的 CPU 温度是坏的，都在 Prometheus 侧丢掉；口径见 playbook 文件头。
# 部署/升级 macmon 功耗/温度/风扇 exporter LaunchAgent（:9090，无需 sudo）
macmon target="macmon":
    ansible-playbook playbooks/macmon.yaml --limit '{{target}}'

# OrbStack 容器/虚拟化环境（Homebrew cask + 无头免密配置 + 开机自启 + 启动服务；三台，无需 sudo，幂等）
orbstack target="base":
    ansible-playbook playbooks/orbstack.yaml --limit '{{target}}'

# 新 Mac 初始化工具（mac-sync）部署与互信配置（无需 sudo，幂等）；日常跨机同步走 git
# 全量 Mac（base 组）自动分发脚本、复制排除规则、建立 SSH 互信与 Host 别名
mac-sync target="base":
    ansible-playbook playbooks/mac-sync.yaml --limit '{{target}}'


# PAT 从 Vault 现取（secret/homelab/multica → daemon_pat）以 -e 传给 playbook，
# 不落盘、不进 git。需要本机已有可用的 vault token（`vault token lookup` 能过）。
#
# ☠️ 别改回浏览器 OAuth：`multica login` 的回调监听在 **Mac 自己的 localhost**，
#    在别处打开那个 URL 是空端口；`--callback-host <TS IP>` 端口虽可达，但有
#    认证等待超时窗口，人机不同步就 timed out（2026-08-18 实测踩过两次）。
#
# PAT 轮换：web UI 生成新的 → `vault kv patch secret/homelab/multica daemon_pat=mul_...`
#
# 部署/升级 Multica daemon LaunchAgent（M2 + Studio 的登录用户，全权限；无需 sudo，幂等，认证全自动）
multica-daemon:
    #!/usr/bin/env bash
    set -euo pipefail
    export VAULT_ADDR="${VAULT_ADDR:-https://vault.meirong.dev}"
    pat="$(vault kv get -field=daemon_pat secret/homelab/multica 2>/dev/null || true)"
    if [ -z "$pat" ]; then
      echo "⚠️  Vault 里没有 secret/homelab/multica → daemon_pat。" >&2
      echo "    未认证时 playbook 会装好一切但**不启动** daemon（避免 crash-loop）。" >&2
      ansible-playbook playbooks/multica-daemon.yaml
    else
      ansible-playbook playbooks/multica-daemon.yaml -e "md_pat=$pat"
    fi

# Studio 上的受限 Multica daemon：专用用户 multica，只读 kubeconfig，没有 git/ssh/Vault 凭据。
# 四份凭据现取，写进 0600 临时 vars 文件传给 playbook（不上命令行，退出即删）。
# 模型默认只有本机 OMLX 的 Qwen；想加 Claude Code 就先在 Vault 放
# secret/homelab/multica → studio_claude_oauth_token（`claude setup-token` 生成），再重跑。
# 部署/升级 Studio 受限 Multica daemon（会问 Studio 登录用户 matstudio 的 sudo 密码，幂等）
multica-studio:
    #!/usr/bin/env bash
    set -euo pipefail
    export VAULT_ADDR="${VAULT_ADDR:-https://vault.meirong.dev}"
    ctx="${KUBE_CONTEXT:-k3s-homelab}"
    MR_PAT="$(vault kv get -field=daemon_pat secret/homelab/multica)"
    MR_CLAUDE_TOKEN="$(vault kv get -field=studio_claude_oauth_token secret/homelab/multica 2>/dev/null || true)"
    if [ -z "$MR_CLAUDE_TOKEN" ]; then
      echo "ℹ️  Vault 里没有 studio_claude_oauth_token：不装 Claude Code，这台只跑 Qwen（本机 OMLX）。" >&2
      echo "    以后要加：\`claude setup-token\` → \`vault kv patch secret/homelab/multica studio_claude_oauth_token=-\` → 重跑本配方。" >&2
    fi
    MR_KUBE_TOKEN="$(kubectl --context "$ctx" -n personal-services get secret multica-agent-token -o jsonpath='{.data.token}' | base64 -d)"
    MR_KUBE_CA="$(kubectl --context "$ctx" -n personal-services get secret multica-agent-token -o jsonpath='{.data.ca\.crt}')"
    if [ -z "$MR_KUBE_TOKEN" ] || [ -z "$MR_KUBE_CA" ]; then
      echo "⚠️  集群里还没有 personal-services/multica-agent-token（ArgoCD 还没同步 multica-agent-rbac.yaml？）。" >&2
      exit 1
    fi
    export MR_PAT MR_CLAUDE_TOKEN MR_KUBE_TOKEN MR_KUBE_CA
    vars="$(mktemp)"; chmod 600 "$vars"; trap 'rm -f "$vars"' EXIT
    jq -n '{mr_pat: env.MR_PAT, mr_claude_token: env.MR_CLAUDE_TOKEN, mr_kube_token: env.MR_KUBE_TOKEN, mr_kube_ca: env.MR_KUBE_CA}' > "$vars"
    ansible-playbook playbooks/multica-daemon-restricted.yaml --ask-become-pass -e "@$vars"

# 应用 headless 电源策略（disablesleep；Studio 另加断电恢复自动开机；逐台问 sudo 密码）
power target="macs":
    #!/usr/bin/env bash
    set -euo pipefail
    for h in $(ansible '{{target}}' --list-hosts | awk 'NR>1{print $1}'); do
      echo "── ${h}：输入它的登录密码"
      ansible-playbook playbooks/power.yaml --limit "$h" --ask-become-pass
    done

# site 会跑 omlx.yaml，所以同样从 Vault 取 OMLX key（见 omlx 配方）。
# 一次跑全部 Ansible 能做的（包/运行时/AI CLI/multica/OMLX/node_exporter/OMLX 指标/macmon/电源；逐台问密码）
site target="macs":
    #!/usr/bin/env bash
    set -euo pipefail
    export VAULT_ADDR="${VAULT_ADDR:-https://vault.meirong.dev}"
    OMLX_API_KEY="$(vault kv get -field=api_key secret/homelab/omlx 2>/dev/null || true)"
    [ -n "$OMLX_API_KEY" ] || echo "⚠️  Vault 里取不到 secret/homelab/omlx → api_key（vault token 过期？）" >&2
    export OMLX_API_KEY
    for h in $(ansible '{{target}}' --list-hosts | awk 'NR>1{print $1}'); do
      echo "── ${h}：输入它的登录密码"
      ansible-playbook playbooks/site.yaml --limit "$h" --ask-become-pass
    done

# 系统更新四个配方共用 playbooks/os-update.yaml，刻意不进 site：site 是可反复跑的配置，
# 这个会重启机器。前置条件与验收内容见 README「系统更新」。
# 只读：列出待装的 macOS 更新、本次会装什么、前置检查是否满足（不要密码，不改任何东西）
os-updates target="macs":
    ansible-playbook playbooks/os-update.yaml --check --limit '{{target}}'

# ⚠️ 需要重启时会**自动重启**并等它回来验收，正在跑的 multica 任务 / OMLX 推理会被中断。
# 大版本（如 macOS 27）一律跳过。确认计划并输入登录密码后才动手。一次只能一台。
# 装 macOS 小版本/安全更新 + Safari/CLT 等（交互输入登录密码；host 必填，如 mbp-m2-pro）
os-update host:
    ansible-playbook playbooks/os-update.yaml --limit '{{host}}'

# 只装免重启的更新（Safari/CLT 等），需重启的一次性留给 just os-update
os-update-no-restart host:
    ansible-playbook playbooks/os-update.yaml --limit '{{host}}' -e allow_restart=false

# ☠️ 大版本升级后可能要重新批准 Tailscale 系统扩展、或停在升级后的设置助手 ——
#    任何一个都会让这台远程机失联，只能去现场处理。确认有人能碰到机器再跑。
# 大版本升级（如 macOS 26 → 27），其余同 os-update
os-upgrade-major host:
    ansible-playbook playbooks/os-update.yaml --limit '{{host}}' -e allow_major=true
