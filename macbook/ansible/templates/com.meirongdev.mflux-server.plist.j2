<?xml version="1.0" encoding="UTF-8"?>
<!-- Managed by Ansible (macbook/ansible/playbooks/image-gen.yaml). Do not edit by hand. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{ ig_server_label }}</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{ ig_python }}</string>
        <string>{{ ig_server_dir }}/server.py</string>
        <string>--model</string>
        <string>{{ ig_model }}</string>
        <!-- ☠️ 只给本机：/api/load、/api/clear 没有鉴权（见 playbook 文件头） -->
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>{{ ig_server_port }}</string>
        <!-- ☠️ 开着的话每个新分辨率多常驻 ~26 GB 而不是 ~13 GB（见 playbook 文件头） -->
        <string>--no-qwen21-context-cache</string>
    </array>
    <!-- 网页界面从 clients/web-ui 相对路径读文件 -->
    <key>WorkingDirectory</key>
    <string>{{ ig_server_dir }}</string>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- ☠️ 离线：不让 HF 上游的权重更新在重启时触发 33 GB 的静默重下（见 playbook 文件头） -->
        <key>HF_HUB_OFFLINE</key>
        <string>1</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- 装载 33 GB 要一两分钟；崩溃循环时别每 10s 就把它重读一遍 -->
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>{{ ig_log_dir }}/mflux-server.log</string>
    <key>StandardErrorPath</key>
    <string>{{ ig_log_dir }}/mflux-server.log</string>
</dict>
</plist>
