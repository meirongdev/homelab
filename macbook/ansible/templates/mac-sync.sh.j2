#!/bin/bash
# Code generated by Ansible (macbook/ansible/playbooks/mac-sync.yaml) - DO NOT EDIT MANUALLY
set -euo pipefail

CONFIG_DIR="${HOME}/.config/mac-sync"
DIRS_FILE="${CONFIG_DIR}/dirs.list"
EXCLUDE_FILE="${CONFIG_DIR}/exclude.list"
LOCK_FILE="${CONFIG_DIR}/sync.lock"
LOG_DIR="${HOME}/Library/Logs"

mkdir -p "${CONFIG_DIR}" "${LOG_DIR}"

# 舰队机器别名列表（由 Ansible 动态维护）
FLEET_PEERS=(
{% for k, v in mac_fleet.items() %}
    "{{ v.ssh_alias }}"
{% endfor %}
)

# 1. 自动判定当前机器身份
detect_current_host() {
    local user
    user=$(whoami)
{% for k, v in mac_fleet.items() %}
{% if v.user != 'matthew' %}
    if [[ "${user}" == "{{ v.user }}" ]]; then
        echo "{{ v.ssh_alias }}"
        return
    fi
{% endif %}
{% endfor %}
    local lhn
    lhn=$(scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null || echo "")
{% for k, v in mac_fleet.items() %}
    if [[ "${lhn}" == "{{ v.host_name }}" ]] || [[ "${lhn}" == "{{ v.ssh_alias }}" ]]; then
        echo "{{ v.ssh_alias }}"
        return
    fi
{% endfor %}
    # 回落通过 IP 探测
    local my_ips
    my_ips=$(ifconfig 2>/dev/null | grep -E "inet " || true)
{% for k, v in mac_fleet.items() %}
    if echo "${my_ips}" | grep -q "{{ v.tailscale_ip }}"; then
        echo "{{ v.ssh_alias }}"
        return
    fi
{% endfor %}
    # 默认回落到本机
    echo "m5"
}

CURRENT_HOST=$(detect_current_host)

# 2. 计算其他候选对端
get_default_peers() {
    local peers=()
    for h in "${FLEET_PEERS[@]}"; do
        if [[ "$h" != "${CURRENT_HOST}" ]]; then
            peers+=("$h")
        fi
    done
    echo "${peers[@]}"
}

# 3. 检查对端连通性（3秒超时）
is_peer_online() {
    local peer="$1"
    ssh -o BatchMode=yes -o ConnectTimeout=3 -o StrictHostKeyChecking=accept-new "${peer}" "true" >/dev/null 2>&1
}

# 4. 加载目录清单
load_dirs() {
    if [[ ! -f "${DIRS_FILE}" ]]; then
        echo "⚠️  未找到目录清单文件: ${DIRS_FILE}" >&2
        return 1
    fi
    local dirs=()
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        [[ -z "$line" || "$line" =~ ^# ]] && continue
        line="${line#\~/}"
        line="${line#/Users/*/}"
        dirs+=("$line")
    done < "${DIRS_FILE}"
    echo "${dirs[@]}"
}

{% raw %}
# 5. 推送目录到对端
do_push() {
    local target_peers=("$@")
    if [[ ${#target_peers[@]} -eq 0 ]]; then
        target_peers=($(get_default_peers))
    fi

    local dirs=($(load_dirs))
    if [[ ${#dirs[@]} -eq 0 ]]; then
        echo "ℹ️  清单为空，无需同步。"
        return 0
    fi

    echo "🚀 [${CURRENT_HOST}] 开始推送同步..."
    for peer in "${target_peers[@]}"; do
        echo -n "  📡 检查连接 ${peer} ... "
        if ! is_peer_online "${peer}"; then
            echo "❌ 离线/休眠（跳过）"
            continue
        fi
        echo "✅ 在线"

        for dir in "${dirs[@]}"; do
            local src="${HOME}/${dir}/"
            if [[ ! -d "${src}" ]]; then
                echo "    ⚠️ 本地目录不存在: ${src} (跳过)"
                continue
            fi
            echo "    📦 [${peer}] 同步 ${dir} ..."
            local parent_dir
            parent_dir=$(dirname "${dir}")
            ssh "${peer}" "mkdir -p ~/${parent_dir}" </dev/null
            
            rsync -au --partial \
                --exclude-from="${EXCLUDE_FILE}" \
                -e "ssh -o ConnectTimeout=10 -o ServerAliveInterval=15" \
                "${src}" "${peer}:${dir}/" </dev/null
        done
        echo "  ✨ 完成对 ${peer} 的推送"
    done
    echo "🎉 全部推送任务完成！"
}

# 6. 从对端拉取目录
do_pull() {
    local src_peer="${1:-}"
    if [[ -z "${src_peer}" ]]; then
        echo "❌ 请指定要从哪台机器拉取，例如: mac-sync pull studio 或 mac-sync pull m2"
        return 1
    fi

    local dirs=($(load_dirs))
    echo "📥 [${CURRENT_HOST}] 开始从 ${src_peer} 拉取最新变更..."
    if ! is_peer_online "${src_peer}"; then
        echo "❌ 机器 ${src_peer} 离线或无法连接"
        return 1
    fi

    for dir in "${dirs[@]}"; do
        local dest="${HOME}/${dir}/"
        mkdir -p "${dest}"
        echo "    📦 拉取 ${dir} ..."
        rsync -au --partial \
            --exclude-from="${EXCLUDE_FILE}" \
            -e "ssh -o ConnectTimeout=10 -o ServerAliveInterval=15" \
            "${src_peer}:${dir}/" "${dest}" </dev/null
    done
    echo "🎉 从 ${src_peer} 拉取完成！"
}

# 7. 查看状态与连通性
do_status() {
    echo "🖥️  当前机器: ${CURRENT_HOST}"
    local peers=($(get_default_peers))
    echo "📡 互通性检查:"
    for peer in "${peers[@]}"; do
        echo -n "  • ${peer}: "
        if is_peer_online "${peer}"; then
            echo "✅ 在线 (SSH 可连通)"
        else
            echo "❌ 离线/休眠"
        fi
    done

    echo ""
    echo "📁 已配置的同步目录清单 (${DIRS_FILE}):"
    local dirs=($(load_dirs))
    for d in "${dirs[@]}"; do
        if [[ -d "${HOME}/${d}" ]]; then
            local size
            size=$(du -sh "${HOME}/${d}" 2>/dev/null | awk '{print $1}')
            echo "  • ~/${d}  [${size}]"
        else
            echo "  • ~/${d}  (本地缺失)"
        fi
    done
}

run_with_lock() {
    exec 200>"${LOCK_FILE}"
    if ! perl -e 'use Fcntl qw(:flock); exit(flock(STDIN, LOCK_EX | LOCK_NB) ? 0 : 1);' <&200; then
        echo "⚠️  另一个 mac-sync 任务正在运行，本次跳过。"
        exit 0
    fi
    "$@"
}

case "${1:-status}" in
    push)
        shift
        run_with_lock do_push "$@"
        ;;
    pull)
        shift
        run_with_lock do_pull "$@"
        ;;
    status)
        do_status
        ;;
    list)
        cat "${DIRS_FILE}"
        ;;
    help|--help|-h)
        cat << 'USAGE'
mac-sync - 跨 Mac 机器代码与工作区增量同步工具

用法:
  mac-sync status         检查当前机器状态、对端连通性与目录清单
  mac-sync push [peer]    将本地目录变更推送到对端（不填 peer 则推给所有在线对端）
  mac-sync pull <peer>    从指定的对端（如 studio 或 m2）拉取最新变更到本地
  mac-sync list           查看当前同步的目录清单
  mac-sync help           显示本帮助信息

配置:
  目录清单: ~/.config/mac-sync/dirs.list (每行一个目录，不提交到 repo)
  过滤规则: ~/.config/mac-sync/exclude.list
USAGE
        ;;
    *)
        echo "❌ 未知命令: $1，查看帮助请运行: mac-sync help"
        exit 1
        ;;
esac
{% endraw %}
