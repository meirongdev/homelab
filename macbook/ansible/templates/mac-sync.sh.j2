#!/bin/bash
# Code generated by Ansible (macbook/ansible/playbooks/mac-sync.yaml) - DO NOT EDIT MANUALLY
set -euo pipefail

CONFIG_DIR="${HOME}/.config/mac-sync"
DIRS_FILE="${CONFIG_DIR}/dirs.list"
EXCLUDE_FILE="${CONFIG_DIR}/exclude.list"
LOCK_FILE="${CONFIG_DIR}/sync.lock"
LOG_DIR="${HOME}/Library/Logs"

mkdir -p "${CONFIG_DIR}" "${LOG_DIR}"

# 舰队机器别名列表（由 Ansible 动态维护）
FLEET_PEERS=(
{% for k, v in mac_fleet.items() %}
    "{{ v.ssh_alias }}"
{% endfor %}
)

# 1. 自动判定当前机器身份
detect_current_host() {
    local user
    user=$(whoami)
{% for k, v in mac_fleet.items() %}
{% if v.user != 'matthew' %}
    if [[ "${user}" == "{{ v.user }}" ]]; then
        echo "{{ v.ssh_alias }}"
        return
    fi
{% endif %}
{% endfor %}
    local lhn
    lhn=$(scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null || echo "")
{% for k, v in mac_fleet.items() %}
    if [[ "${lhn}" == "{{ v.host_name }}" ]] || [[ "${lhn}" == "{{ v.ssh_alias }}" ]]; then
        echo "{{ v.ssh_alias }}"
        return
    fi
{% endfor %}
    # 回落通过 IP 探测
    local my_ips
    my_ips=$(ifconfig 2>/dev/null | grep -E "inet " || true)
{% for k, v in mac_fleet.items() %}
    if echo "${my_ips}" | grep -q "{{ v.tailscale_ip }}"; then
        echo "{{ v.ssh_alias }}"
        return
    fi
{% endfor %}
    # 默认回落到本机
    echo "m5"
}

CURRENT_HOST=$(detect_current_host)

# 2. 计算其他候选对端
get_default_peers() {
    local peers=()
    for h in "${FLEET_PEERS[@]}"; do
        if [[ "$h" != "${CURRENT_HOST}" ]]; then
            peers+=("$h")
        fi
    done
    echo "${peers[@]}"
}

# 3. 检查对端连通性（3秒超时）
is_peer_online() {
    local peer="$1"
    ssh -o BatchMode=yes -o ConnectTimeout=3 -o StrictHostKeyChecking=accept-new "${peer}" "true" >/dev/null 2>&1
}

# 4. 加载目录清单
load_dirs() {
    if [[ ! -f "${DIRS_FILE}" ]]; then
        echo "⚠️  未找到目录清单文件: ${DIRS_FILE}" >&2
        return 1
    fi
    local dirs=()
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        [[ -z "$line" || "$line" =~ ^# ]] && continue
        line="${line#\~/}"
        line="${line#/Users/*/}"
        dirs+=("$line")
    done < "${DIRS_FILE}"
    echo "${dirs[@]}"
}

{% raw %}
# 5. 初始化新机器：把清单里的目录整份（含 .git 与未提交改动）复制到对端
#    只用于新机器，日常同步走 git push/pull。rsync 只比 mtime、不传删除，往已在用的
#    机器上推会互相覆盖（2026-10-24 实测），所以对端已存在的目录整个跳过、从不写入。
#    先复制到 <dir>.mac-sync-partial，传完才改名；中断后重跑会接着传。
do_push() {
    local peer="${1:-}"
    if [[ -z "${peer}" ]]; then
        echo "❌ 请指定新机器，例如: mac-sync push m2（只用于初始化新机器，日常同步走 git）"
        return 1
    fi

    local dirs=($(load_dirs))
    if [[ ${#dirs[@]} -eq 0 ]]; then
        echo "ℹ️  清单为空，无需复制。"
        return 0
    fi

    echo -n "📡 检查连接 ${peer} ... "
    if ! is_peer_online "${peer}"; then
        echo "❌ 离线/休眠"
        return 1
    fi
    echo "✅ 在线"

    echo "🚀 [${CURRENT_HOST}] 开始初始化 ${peer} ..."
    for dir in "${dirs[@]}"; do
        local src="${HOME}/${dir}/"
        if [[ ! -d "${src}" ]]; then
            echo "    ⚠️ 本地目录不存在: ${src} (跳过)"
            continue
        fi
        if ssh "${peer}" "test -e ~/${dir}" </dev/null; then
            echo "    ⏭️  [${peer}] ~/${dir} 已存在，跳过（已在用的目录走 git 同步）"
            continue
        fi
        echo "    📦 [${peer}] 复制 ${dir} ..."
        local staging="${dir}.mac-sync-partial"
        ssh "${peer}" "mkdir -p ~/$(dirname "${dir}")" </dev/null
        rsync -a --partial \
            --exclude-from="${EXCLUDE_FILE}" \
            -e "ssh -o ConnectTimeout=10 -o ServerAliveInterval=15" \
            "${src}" "${peer}:${staging}/" </dev/null
        ssh "${peer}" "test ! -e ~/${dir} && mv ~/${staging} ~/${dir}" </dev/null
    done
    echo "🎉 ${peer} 初始化完成！"
}

# 6. 查看状态与连通性
do_status() {
    echo "🖥️  当前机器: ${CURRENT_HOST}"
    local peers=($(get_default_peers))
    echo "📡 互通性检查:"
    for peer in "${peers[@]}"; do
        echo -n "  • ${peer}: "
        if is_peer_online "${peer}"; then
            echo "✅ 在线 (SSH 可连通)"
        else
            echo "❌ 离线/休眠"
        fi
    done

    echo ""
    echo "📁 已配置的同步目录清单 (${DIRS_FILE}):"
    local dirs=($(load_dirs))
    for d in "${dirs[@]}"; do
        if [[ -d "${HOME}/${d}" ]]; then
            local size
            size=$(du -sh "${HOME}/${d}" 2>/dev/null | awk '{print $1}')
            echo "  • ~/${d}  [${size}]"
        else
            echo "  • ~/${d}  (本地缺失)"
        fi
    done
}

run_with_lock() {
    exec 200>"${LOCK_FILE}"
    if ! perl -e 'use Fcntl qw(:flock); exit(flock(STDIN, LOCK_EX | LOCK_NB) ? 0 : 1);' <&200; then
        echo "⚠️  另一个 mac-sync 任务正在运行，本次跳过。"
        exit 0
    fi
    "$@"
}

case "${1:-status}" in
    push)
        shift
        run_with_lock do_push "$@"
        ;;
    status)
        do_status
        ;;
    list)
        cat "${DIRS_FILE}"
        ;;
    help|--help|-h)
        cat << 'USAGE'
mac-sync - 新 Mac 初始化：把开发目录整份复制到新机器（日常同步走 git push/pull）

用法:
  mac-sync status         检查当前机器状态、对端连通性与目录清单
  mac-sync push <peer>    把清单里的目录复制到新机器（对端已存在的目录整个跳过，从不覆盖）
  mac-sync list           查看目录清单
  mac-sync help           显示本帮助信息

配置:
  目录清单: ~/.config/mac-sync/dirs.list (每行一个目录，不提交到 repo)
  过滤规则: ~/.config/mac-sync/exclude.list
USAGE
        ;;
    *)
        echo "❌ 未知命令: $1，查看帮助请运行: mac-sync help"
        exit 1
        ;;
esac
{% endraw %}
