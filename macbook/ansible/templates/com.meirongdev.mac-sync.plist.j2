<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.meirongdev.mac-sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>{{ ansible_facts.user_dir }}/.local/bin/mac-sync push</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>{{ ansible_facts.user_dir }}/Library/Logs/mac-sync.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>{{ ansible_facts.user_dir }}/Library/Logs/mac-sync.stderr.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
