# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Terraform plan output
plan
plan.out
*.plan

# OS specific files
.DS_Store
.DS_Store?
._*

# Editor specific files
.vscode/
.idea/
*.swp
*.swo
*~

# Log files
*.log

# Environment variables
.env
!.env.example

# Vault keys
vault-keys.json

# Cloudflare credentials (NEVER commit)
cloudflare_credential.md

# Backup files
*.bak
*.tmp

# Merge conflict leftovers
*.orig

# Packer
credentials.pkr.hcl
variables.json
variables.auto.pkrvars.hcl

# Git worktrees
.worktrees/
**/vault_values.md

# per-agent 安装的工具 — 本机各装一份，不是仓库内容
# ⚠️ opsx / OpenSpec 已于 2026-09-08 整套移除（ROADMAP 开放项 #14 收在「停用」这条），
#    连带删掉的规则：`.agent/` `.codex/` `.gemini/` `openspec/` `.claude/commands/`
#    `.claude/skills/openspec-*/` `.qwen/commands/` `.github/{prompts,skills}/`
#    —— 那些目录当时 100% 是 opsx 独占。别照着旧提交把它们加回来。
#    ⚠️ 注意 `.agent/`（已删，opsx）与 `.agents/`（vendored 第三方技能，**进 git**）是两个目录。
.qwen/skills/
.qwen/tmp/
.qwen/skill-curator.json
proxmox/ansible/.vault_pass
.gstack/

# Agent 本地设置：允许列表里可能内联真实凭据（如 wrangler 命令带 CLOUDFLARE_API_TOKEN）。
# 此前只靠 ~/.config/git/ignore 这条全局规则挡着——换台机器/新克隆就没保护了，故在 repo 内固化。
.claude/settings.local.json
.qwen/settings.local.json

# Python bytecode（clean checkout 里不该有；k8s 清单目录下的 .py 是被内嵌进 ConfigMap 的源）
__pycache__/
*.py[cod]
