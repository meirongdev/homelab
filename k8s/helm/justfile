# ⬇️ Cilium CNI ⬇️

# 安装/升级 Gateway API CRD（Cilium 的**前置条件**，不是可选项）。
# ☠️ 这组 CRD 以前是带外手工装的、不在任何配方里，所以升 Cilium 时没人想起要同步升它们——
#    2026-08-11 两集群 Gateway API 控制器静默瘫痪 30 小时就是这么来的（详见文件顶部
#    cilium_version 上方的长注释）。收进配方就是为了让它跟着 cilium_version 一起被看见。
# ⚠️ 必须 --server-side：httproutes 的 CRD 有 429KB，客户端 apply 会撑爆
#    last-applied-configuration 注解的大小上限。
# ⚠️ TLSRoute 只在 **experimental** 频道发布，standard 频道没有；Cilium 仍要求它存在。
# 幂等，可重复执行；跑完自动重启 operator（它只在**启动时**做这项检查）。
deploy-gateway-api-crds:
    #!/usr/bin/env bash
    set -euo pipefail
    base="https://raw.githubusercontent.com/kubernetes-sigs/gateway-api/v{{gateway_api_version}}/config/crd"
    for c in gatewayclasses gateways httproutes grpcroutes referencegrants backendtlspolicies; do
        echo "→ standard/$c"
        kubectl --context {{ctx}} apply --server-side --force-conflicts \
            -f "$base/standard/gateway.networking.k8s.io_$c.yaml"
    done
    echo "→ experimental/tlsroutes"
    kubectl --context {{ctx}} apply --server-side --force-conflicts \
        -f "$base/experimental/gateway.networking.k8s.io_tlsroutes.yaml"
    kubectl --context {{ctx}} -n kube-system rollout restart deploy/cilium-operator
    kubectl --context {{ctx}} -n kube-system rollout status deploy/cilium-operator --timeout=3m
    # 真正的验收：控制器起来了没有。别拿「旧域名还能 200」当证据。
    if kubectl --context {{ctx}} -n kube-system logs deploy/cilium-operator --tail=300 \
        | grep -q "Required GatewayAPI resources are not found"; then
        echo "❌ Gateway API 控制器仍未初始化 —— 核对 CRD 版本与 Cilium 要求" && exit 1
    fi
    echo "✅ Gateway API CRD = v{{gateway_api_version}}，控制器已初始化"

# 部署 Cilium（CNI + Gateway API + ClusterMesh 控制面）；唯一真源 ../cilium/values.yaml，见 k8s/cilium/README.md
# ⚠️ 升级 Cilium 前先跑 `just deploy-gateway-api-crds`（或至少核对 gateway_api_version）。
deploy-cilium: add-repos
    #!/usr/bin/env bash
    set -euo pipefail
    # 真源 ../cilium/values.yaml 含 gatewayAPI.enableAppProtocol（ZITADEL console 必需）；--version 对齐 v1.19.1 镜像。
    # ClusterMesh CA 属密钥（不入库）：升级时从在集群恢复以保住 mesh 互信，全新安装让 Cilium 自签新 CA。
    ctx="{{ctx}}"
    # Drop stale Hubble cert secrets so certgen re-issues them for the current cluster name.
    # Also drop OLD certgen jobs: the wait below selects by label and would match a
    # stale completed job, then fail on the missing secrets (bit us 2026-07-07).
    kubectl --context "$ctx" -n kube-system delete secret hubble-server-certs hubble-relay-client-certs --ignore-not-found
    kubectl --context "$ctx" -n kube-system delete job -l k8s-app=hubble-generate-certs --ignore-not-found
    # Restore the live ClusterMesh CA on upgrade; on a fresh install let Cilium self-sign one.
    if kubectl --context "$ctx" -n kube-system get secret cilium-ca >/dev/null 2>&1; then
        kubectl --context "$ctx" -n kube-system get secret cilium-ca -o jsonpath='{.data.ca\.crt}' | base64 -d > /tmp/cilium-ca.crt
        ca_args=(--set-file tls.caBundle.content=/tmp/cilium-ca.crt)
        echo "restoring live cilium-ca → ClusterMesh trust preserved"
    else
        ca_args=(--set tls.caBundle.enabled=false)
        echo "fresh install: Cilium will self-sign a CA — re-run 'just connect-clustermesh ...' afterwards"
    fi
    # --reset-values scrubs stale ad-hoc --set values from earlier manual installs.
    helm upgrade --install cilium cilium/cilium \
        --namespace kube-system \
        --kube-context "$ctx" \
        --version {{cilium_version}} \
        --values ../cilium/values.yaml \
        "${ca_args[@]}" \
        --reset-values \
        --wait \
        --timeout 10m
    # helm's post-upgrade hook does not reliably fire a fresh certgen job on every
    # upgrade — trigger one from the cronjob so the wait below has something real.
    kubectl --context "$ctx" -n kube-system create job --from=cronjob/hubble-generate-certs "hubble-certs-manual-$(date +%s)" || true
    found=""
    for _ in $(seq 1 24); do
        if kubectl --context "$ctx" -n kube-system get job -l k8s-app=hubble-generate-certs -o name | grep -q .; then
            kubectl --context "$ctx" -n kube-system wait --for=condition=complete job -l k8s-app=hubble-generate-certs --timeout=5m
            found=1; break
        fi
        sleep 5
    done
    [ -n "$found" ] || { echo "Timed out waiting for hubble-generate-certs job creation" >&2; exit 1; }
    kubectl --context "$ctx" -n kube-system get secret hubble-server-certs hubble-relay-client-certs
    kubectl --context "$ctx" -n kube-system rollout status deployment/hubble-relay --timeout=5m
    kubectl --context "$ctx" -n kube-system rollout restart deploy/cilium-operator
    kubectl --context "$ctx" exec -n kube-system ds/cilium -c cilium-agent -- cilium status --brief
    echo ""
    echo "⚠️  --reset-values 会冲掉跨集群 CA 信任 → ClusterMesh 会静默断开（2026-08-10 实测）。"
    echo "   现在必须跑：just connect-clustermesh 100.94.186.7:32379 100.107.166.37:32379"
    echo "   判据看 'cilium status' 的 remote configuration: retrieved=true"

# Cilium 状态检查
cilium-status:
    kubectl --context {{ctx}} exec -n kube-system ds/cilium -c cilium-agent -- cilium status --brief

# 检查双向 ClusterMesh / KVStoreMesh 状态
clustermesh-status:
    cilium clustermesh status --context k3s-homelab --wait
    cilium clustermesh status --context oracle-k3s --wait

# 通过 Tailscale NodePort 重新建立双向 ClusterMesh（重装任一集群后执行）
connect-clustermesh homelab_endpoint oracle_endpoint:
    cilium clustermesh connect \
        --context k3s-homelab \
        --destination-context oracle-k3s \
        --source-endpoint {{homelab_endpoint}} \
        --destination-endpoint {{oracle_endpoint}} \
        --allow-mismatching-ca
    just clustermesh-status

