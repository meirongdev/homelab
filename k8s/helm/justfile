namespace := "monitoring"
ctx := "k3s-homelab"

# Pinned Helm chart versions — bump deliberately after reviewing release notes.
# Match what is currently deployed on the cluster (see `helm list -A`).
# ⚠️ 只有仍需手动管理的 release 在这里 pin（cilium/vault/eso；argocd 的 pin 是
# `argocd_chart_version`，就在 deploy-argocd 上方，跟着那条配方走）。
# LGTM/otel/external-dns 已全部迁 ArgoCD（2026-07-31）：chart 版本唯一真源是
# argocd/applications/<app>.yaml 的 targetRevision——不要在这里重复维护（此前双 pin 漂移过：loki 7.0.0 vs 7.1.0）。
# 2026-08-10 1.19.1 → 1.20.0：oracle 侧 `just deploy-cilium` 当时**没有 --version**
# （只有本文件 pin 了），一次例行部署就随 chart repo 升到了 1.20.0，两集群版本劈叉
# 导致 oracle→homelab ClusterMesh `retrieved=false`（单向断，homelab→oracle 仍好）。
# 选择向前对齐而非回滚。1.20 的四条 breaking change 中三条本仓库确实不命中：
# CiliumNodeConfig v2alpha1 0 个、带 kafka/l7/l7proto 的 CNP/CCNP 0 条、未用自定义 CNI chaining。
#
# ☠️ **但「Gateway API 需 ≥v1.6.1」那条当时判错了，代价是两集群入口静默半瘫 30 小时**
# （2026-08-11 查明）。原结论写的是「实质就是 TLSRoute v1alpha2→v1，本仓库只用 HTTPRoute，
# 实测 1.20 + Gateway API v1.2.1 入口全部 200」。错在两处：
#   1. 它不只关乎 TLSRoute。Cilium 1.20 的 operator 在启动时**硬性检查**
#      TLSRoute / BackendTLSPolicy / ReferenceGrant(**必须提供 v1**) 三个 CRD 是否齐备，
#      少任何一个就**整个 Gateway API 控制器不初始化**——哪怕你一条 TLSRoute 都没有。
#   2. 「入口全部 200」这个验证方法**恰恰看不见这种故障**：已建路由的 datapath 早就编程好了、
#      会一直生效，所以旧域名照常 200；死掉的只是**调和新路由的能力**。
#      故障因此完全静默，直到 2026-08-11 加 bentopdf 时第一条新 HTTPRoute 拿不到 status、
#      pdf.meirong.dev 503 才暴露。homelab 08-10 07:08Z 挂、oracle 08-10 19:07Z 挂。
#   教训：验证 Gateway API 是否健康，**不能只 curl 旧域名**，要看
#     `kubectl -n kube-system logs deploy/cilium-operator | grep "Required GatewayAPI resources"`
#     以及新建路由能否拿到 `.status`。
# ⚠️ 因此 cilium_version 与 gateway_api_version 是**一对**，升级 Cilium 必须同步核对后者。
# renovate: datasource=helm depName=cilium registryUrl=https://helm.cilium.io
cilium_version           := "1.20.0"
# Cilium 1.20 要求的 Gateway API CRD 版本（见 `just deploy-gateway-api-crds`）。
# 升级前先读 Cilium 对应版本文档的 Gateway API 前置条件，别假设旧 CRD 还能用。
# renovate: datasource=github-releases depName=kubernetes-sigs/gateway-api
gateway_api_version      := "1.6.1"
# renovate: datasource=helm depName=vault registryUrl=https://helm.releases.hashicorp.com
vault_version            := "0.33.0"
# renovate: datasource=helm depName=external-secrets registryUrl=https://charts.external-secrets.io
eso_version              := "2.6.0"

# ⚠️ 紧急回滚 / 手动重部署（仅 ArgoCD 不可用时；配置真源仍是 values/<app>.yaml）：
