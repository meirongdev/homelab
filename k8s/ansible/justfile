# Reset all k8s nodes to a clean state
cleanup-k8s:
    ansible-playbook playbooks/cleanup-k8s.yaml

# Setup K3s cluster on the k8s nodes
setup-k8s:
    ansible-playbook playbooks/setup-k3s.yaml

# Setup K3s via Tailscale 直连（远程/不在家庭 LAN 时用；覆盖 inventory 的 LAN ProxyCommand，
# 改连节点 Tailscale IP，user/key 仍取自 inventory: ubuntu / ~/.ssh/vgio）
setup-k8s-remote:
    ansible-playbook playbooks/setup-k3s.yaml -e ansible_host=100.94.186.7 -e "ansible_ssh_common_args="

# 重启 k3s（配合 setup-k8s-remote，让 protect-kernel-defaults 生效）—— 同样 Tailscale 直连
restart-k3s-remote:
    ansible k8s_masters -m systemd -a "name=k3s state=restarted" --become -e ansible_host=100.94.186.7 -e "ansible_ssh_common_args="

# Fetch kubeconfig from the control-plane node to local machine
fetch-kubeconfig:
    ansible-playbook playbooks/fetch-kubeconfig.yaml

# Disable ufw on homelab nodes (Cilium manages datapath; host firewall caused reboot-time access loss)
update-firewall:
    ansible-playbook playbooks/update-firewall.yaml

# Remove k3s-homelab config from local kubeconfig
remove-kubeconfig:
    kubectl config delete-cluster k3s-homelab || true
    kubectl config delete-user k3s-homelab-admin || true
    kubectl config delete-context k3s-homelab || true
    @echo "✅ Removed k3s-homelab configuration from ~/.kube/config"

# Install public key
config-ssh-key:
    ansible-playbook playbooks/config-ssh-access.yaml

# Install Prometheus Node Exporter on all nodes
install-node-exporter:
    ansible-playbook playbooks/install-node-exporter.yaml

# Install Tailscale daemon and join tailnet as subnet router (advertises 10.42/10.43)
# Usage: just setup-tailscale <authkey>
setup-tailscale authkey:
    ansible-playbook playbooks/setup-tailscale.yaml \
      -e "tailscale_authkey={{ authkey }}" \
      --private-key ~/.ssh/vgio

# 只给 106 上的 worker 装 Tailscale（控制面已装；本配方 --limit 到 worker 避免误动 prod）
# 密钥: cd ../../tailscale/terraform && just homelab-worker-authkey
# Usage: just setup-tailscale-worker <authkey>
setup-tailscale-worker authkey:
    ansible-playbook playbooks/setup-tailscale.yaml \
      --limit k8s_workers \
      -e "tailscale_authkey={{ authkey }}" \
      --private-key ~/.ssh/vgio

# 把 106 上的 VM 以 agent 身份加入本集群（先跑 setup-tailscale-worker，见剧本头 ③/③b）
# token 经 k8s-node 的 **Tailscale 地址**取——不依赖在家庭 LAN，远程也能跑。
# （历史：2026-08-13 前这么写是因为 ProxyCommand 路径坏——k8s-node 缺 5240 回程规则；
#   当日已修（records/2026-08-13-iprule-guard-render-bug.md），tailnet 取法因更通用而保留。）
join-worker:
    #!/usr/bin/env bash
    set -euo pipefail
    TOKEN=$(ssh -i ~/.ssh/vgio -o BatchMode=yes ubuntu@100.94.186.7 \
      'sudo cat /var/lib/rancher/k3s/server/node-token')
    ansible-playbook playbooks/setup-k3s-worker.yaml \
      --private-key ~/.ssh/vgio \
      -e "k3s_token=$TOKEN"

# Fix DNS fallback on K3s nodes and reapply CoreDNS public upstreams
# Run after network interruption if image pulls fail (CoreDNS can't resolve external names)
fix-dns:
    ansible-playbook playbooks/fix-dns-fallback.yaml